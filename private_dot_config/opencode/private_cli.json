{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "keybinds": {
    "agent.cycle": "tab,shift+tab",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.message.next": "ctrl+n",
    "session.message.previous": "ctrl+p",
    "command.palette.show": "alt+p",
    "app.exit": "ctrl+c,<leader>q",
    "input.delete": "delete,shift+delete"
  }
}
